# Configuration pour l'API Opendatasoft Explore
# Copiez ce fichier vers .env et remplissez vos valeurs

# Domaine de votre portail Opendatasoft (avec /api/explore/v2.1)
OPENDATASOFT_BASE_URL=https://votre-domaine.opendatasoft.com/api/explore/v2.1

# Votre clé API Opendatasoft
OPENDATASOFT_API_KEY=votre_cle_api_ici